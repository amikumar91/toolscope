# Copy to a file OUTSIDE the repo (e.g. ~/.toolscope-live.env), fill in, and load it before running:
#   bash/zsh:    set -a; . ~/.toolscope-live.env; set +a
#   PowerShell:  Get-Content ~/.toolscope-live.env | ? { $_ -match '^\s*[^#].*=' } | % { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
# Everything is optional: set only what you use (uncomment B lines as needed). These are LiteLLM's own variables.

# --- A) direct provider keys (default endpoints) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- B) a router / gateway (LiteLLM proxy, OpenRouter, a company gateway ...) ---
# Put the router's key in the provider key vars above, and its URL here. OpenAI-format bases usually
# end in /v1; Anthropic- and Gemini-format bases usually don't (LiteLLM appends the path).
# OPENAI_API_BASE=
# ANTHROPIC_API_BASE=
# GEMINI_API_BASE=

# Model ids as the router names them, if they differ (defaults in suite.yaml). A router that only speaks
# the OpenAI format: prefix every model with openai/, e.g. openai/google/gemini-4-hydrogen.
# TOOLSCOPE_CLAUDE_MODEL=
# TOOLSCOPE_OPENAI_MODEL=
# TOOLSCOPE_GEMINI_MODEL=
